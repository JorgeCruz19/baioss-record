<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Motor FFmpeg.
    Implementa IRecorderEngine / ISegmenter / IProxyGenerator construyendo y
    supervisando procesos FFmpeg. Es infraestructura: depende de Application + Domain.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Baioss.Record.Domain\Baioss.Record.Domain.csproj" />
    <ProjectReference Include="..\Baioss.Record.Application\Baioss.Record.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logging estructurado; el resto de FFmpeg se invoca como proceso externo. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- El motor de captura (Infrastructure) mata el proceso del supervisor en un test determinista de caída. -->
    <InternalsVisibleTo Include="Baioss.Record.Infrastructure" />
    <!-- Tests del detector de crecimiento de archivo (#55) y del supervisor. -->
    <InternalsVisibleTo Include="Baioss.Record.UnitTests" />
  </ItemGroup>

</Project>
