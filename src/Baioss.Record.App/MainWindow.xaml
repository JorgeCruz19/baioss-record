<Window x:Class="Baioss.Record.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Baioss.Record.App"
        Title="Baioss Record" Height="900" Width="1600" WindowState="Maximized"
        Icon="/Assets/icon.ico"
        Background="#10131A" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Barra de título de la app -->
        <Border DockPanel.Dock="Top" Background="#0C0F15" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="🔑 Licencia"
                            Command="{Binding OpenLicenseCommand}" Style="{StaticResource TransportButton}"/>
                    <Button Content="🛠 Configuración" Margin="8,0,0,0"
                            Command="{Binding OpenGeneralSettingsCommand}" Style="{StaticResource TransportButton}"/>
                    <Button Content="🗄 Almacenamiento" Margin="8,0,0,0"
                            Command="{Binding OpenStorageSettingsCommand}" Style="{StaticResource TransportButton}"/>
                    <Button Content="🗂 Grabaciones" Margin="8,0,0,0"
                            Command="{Binding OpenRecordingsCommand}" Style="{StaticResource TransportButton}"/>
                    <Button Content="🎛 Entradas" Margin="8,0,0,0"
                            Command="{Binding OpenInputsCommand}" Style="{StaticResource TransportButton}"/>
                    <Button Content="🕒 Programación" Margin="8,0,0,0"
                            Command="{Binding OpenScheduleCommand}" Style="{StaticResource TransportButton}"/>
                    <Button Content="⚙ Presets de grabación" Margin="8,0,0,0"
                            Command="{Binding OpenPresetsCommand}" Style="{StaticResource TransportButton}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BAIOSS" FontSize="18" FontWeight="Bold" Foreground="#E6E9EF"/>
                    <TextBlock Text="RECORD" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding ChannelsSubtitle}" FontSize="13"
                               Foreground="#8A92A0" Margin="12,3,0,0" VerticalAlignment="Center"/>
                    <!-- Licencia: la pastilla solo aparece si hay algo que atender (prueba en curso, caducada o
                         no verificable). Con licencia activa no se molesta al operador. -->
                    <Border VerticalAlignment="Center" Margin="16,0,0,0" CornerRadius="6" Padding="10,4"
                            Visibility="{Binding ShowLicense, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource ButtonBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LicenseNeedsAttention}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SignalAmberBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔑" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding LicenseText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Indicador GLOBAL de almacenamiento (Fase 4b): visible también en reposo; color por salud -->
                    <Border VerticalAlignment="Center" Margin="16,0,0,0" CornerRadius="6" Padding="10,4"
                            ToolTip="{Binding StorageTooltip}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource ButtonBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StorageHealth}" Value="Warning">
                                        <Setter Property="Background" Value="{StaticResource SignalAmberBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StorageHealth}" Value="Critical">
                                        <Setter Property="Background" Value="{StaticResource RecBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StorageHealth}" Value="Emergency">
                                        <Setter Property="Background" Value="{StaticResource RecBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding StorageText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Franja de alerta de almacenamiento (Fase 4b): visible solo en crítico/emergencia, MUY visible para 24/7. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource RecBrush}" Padding="16,8"
                Visibility="{Binding ShowStorageBanner, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StorageBannerText}" Foreground="White" FontWeight="Bold" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <!-- Un panel por canal, SIEMPRE en una sola fila (UniformGrid Rows="1"): N canales → N columnas.
             Con más canales cada panel se hace más estrecho, pero el preview conserva toda la altura.
             MaxWidth (720 px por canal, calculado en el VM): con 1-2 canales, sin tope, cada panel se
             estiraba a TODO el ancho y el preview quedaba desproporcionado; con el tope la tira queda
             centrada (Stretch + MaxWidth centra) y con 3-4 canales el tope no llega a morder. -->
        <ItemsControl ItemsSource="{Binding Channels}" MaxWidth="{Binding ChannelStripMaxWidth}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:ChannelView/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
