<app:SecondaryWindow x:Class="Baioss.Record.App.Audit.AuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Baioss.Record.App"
        xmlns:loc="clr-namespace:Baioss.Record.App.Localization"
        Title="{loc:T Audit_Title}" Width="1240" Height="660" MinWidth="960" MinHeight="440"
        Icon="/Assets/icon.ico"
        Background="#10131A" WindowStartupLocation="CenterOwner">

    <DockPanel>
        <!-- Cabecera -->
        <Border DockPanel.Dock="Top" Background="#0C0F15" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{loc:T Audit_Header}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{loc:T Audit_Subtitle}"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Filtros + resumen -->
        <Border DockPanel.Dock="Top" Background="#0C0F15" Padding="16,0,16,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="140" Height="30" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}"
                              VerticalAlignment="Center"/>
                    <ComboBox Width="160" Height="30" Margin="8,0,0,0" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}"
                              VerticalAlignment="Center"/>
                    <ComboBox Width="170" Height="30" Margin="8,0,0,0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                              VerticalAlignment="Center"/>
                    <ComboBox Width="150" Height="30" Margin="8,0,0,0" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"
                              VerticalAlignment="Center"/>
                    <Button Content="{loc:T Audit_Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource TransportButton}"
                            Height="30" Margin="8,0,0,0" Padding="14,0"/>
                    <Button Content="{loc:T Audit_Export}" Command="{Binding ExportCommand}" Style="{StaticResource TransportButton}"
                            ToolTip="{loc:T Audit_Export_Tooltip}" Height="30" Margin="8,0,0,0" Padding="14,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Pie -->
        <Border DockPanel.Dock="Bottom" Background="#0C0F15" Padding="16,10">
            <Button Content="{loc:T Common_Close}" Click="Close_Click" HorizontalAlignment="Right"
                    Height="32" MinWidth="100" Padding="20,0" Style="{StaticResource TransportButton}"/>
        </Border>

        <!-- Encabezado de tabla -->
        <Border DockPanel.Dock="Top" Background="#0C0F15" Padding="18,6,34,6" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="{loc:T Audit_Col_When}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{loc:T Audit_Col_Severity}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="3" Text="{loc:T Audit_Col_Event}"    FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="4" Text="{loc:T Audit_Col_Channel}"  FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="5" Text="{loc:T Audit_Col_Operator}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="6" Text="{loc:T Audit_Col_Detail}"   FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </Border>

        <!-- Mensaje vacío -->
        <TextBlock DockPanel.Dock="Top" Text="{loc:T Audit_Empty}"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="18,24,0,0"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

        <!-- Filas. VirtualizingStackPanel: la auditoría puede traer miles de entradas y sin virtualizar
             la ventana tardaría en abrir y comería memoria. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,2">
            <ItemsControl ItemsSource="{Binding Entries}" Margin="16,2"
                          VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding DateText}" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" VerticalAlignment="Center" FontSize="12"/>

                                <!-- Chip de nivel: gris lo rutinario, ámbar los avisos, rojo errores y críticos.
                                     Es lo que permite barrer una noche entera de un vistazo. -->
                                <Border Grid.Column="2" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource ButtonBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SignalAmberBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource RecBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource RecBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="SemiBold"/>
                                </Border>

                                <TextBlock Grid.Column="3" Text="{Binding EventText}" VerticalAlignment="Center" FontSize="12"
                                           FontWeight="SemiBold" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="4" Text="{Binding ChannelKey}" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Grid.Column="5" Text="{Binding Operator}" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Operator}"/>
                                <TextBlock Grid.Column="6" Text="{Binding Detail}" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Detail}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</app:SecondaryWindow>
