<Window x:Class="Baioss.Record.App.Licensing.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Baioss.Record.App.Localization"
        Title="{loc:T Lic_Title}" Width="640" SizeToContent="Height"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="#10131A" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0C0F15" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{loc:T Lic_Header}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{loc:T Lic_Subtitle}"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#0C0F15" Padding="16,10">
            <Button Content="{loc:T Common_Close}" Click="Close_Click" HorizontalAlignment="Right"
                    Height="32" MinWidth="100" Padding="20,0" Style="{StaticResource TransportButton}"/>
        </Border>

        <StackPanel Margin="16,14">
            <!-- Estado -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:T Lic_State}" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="5" Padding="10,5" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SignalGreenBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SignalAmberBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="Bold" Foreground="#0C0F15"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding DetailText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Código de equipo -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:T Lic_MachineCode}" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{loc:T Lic_MachineCode_Hint}"
                               FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding MachineCode, Mode=OneWay}" IsReadOnly="True"
                                 Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                 FontFamily="Consolas" FontSize="15" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="{loc:T Lic_Copy}" Command="{Binding CopyMachineCodeCommand}"
                                Style="{StaticResource TransportButton}" Height="34" Padding="18,0" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Activación -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="{loc:T Lic_ActivateHeader}" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="64" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6"
                             FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Message}" VerticalAlignment="Center"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SignalGreenBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource RecBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Content="{loc:T Lic_Activate}" Command="{Binding ActivateCommand}"
                                Style="{StaticResource StartButton}" Height="32" MinWidth="120" Padding="18,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
