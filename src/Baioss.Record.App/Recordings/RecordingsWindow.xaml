<Window x:Class="Baioss.Record.App.Recordings.RecordingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Baioss.Record.App.Localization"
        Title="{loc:T Rec_Title}" Width="1180" Height="640" MinWidth="900" MinHeight="420"
        Icon="/Assets/icon.ico"
        Background="#10131A" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Botón de acción compacto por fila -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Cabecera -->
        <Border DockPanel.Dock="Top" Background="#0C0F15" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{loc:T Rec_Header}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{loc:T Rec_Subtitle}"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Filtros + resumen -->
        <Border DockPanel.Dock="Top" Background="#0C0F15" Padding="16,0,16,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="150" Height="30" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}"
                              VerticalAlignment="Center"/>
                    <ComboBox Width="170" Height="30" Margin="8,0,0,0" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}"
                              VerticalAlignment="Center"/>
                    <Button Content="{loc:T Rec_Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource TransportButton}"
                            Height="30" Margin="8,0,0,0" Padding="14,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Pie -->
        <Border DockPanel.Dock="Bottom" Background="#0C0F15" Padding="16,10">
            <Button Content="{loc:T Common_Close}" Click="Close_Click" HorizontalAlignment="Right"
                    Height="32" MinWidth="100" Padding="20,0" Style="{StaticResource TransportButton}"/>
        </Border>

        <!-- Encabezado de tabla -->
        <Border DockPanel.Dock="Top" Background="#0C0F15" Padding="18,6,34,6" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T Rec_Channel}"     FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{loc:T Rec_Name}"    FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{loc:T Rec_Date}"     FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="3" Text="{loc:T Rec_Time}"      FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="4" Text="{loc:T Rec_Duration}"  FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="5" Text="{loc:T Rec_Size}"    FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="6" Text="{loc:T Rec_Operator}"  FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="7" Text="{loc:T Rec_Protection}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="8" Text="{loc:T Rec_Actions}"  FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Mensaje vacío -->
        <TextBlock DockPanel.Dock="Top" Text="{loc:T Rec_Empty}"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="18,24,0,0"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

        <!-- Filas -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,2">
            <ItemsControl ItemsSource="{Binding Recordings}" Margin="16,2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="4"
                                        Width="26" Height="24" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ChannelKey}" FontWeight="Bold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                <TextBlock Grid.Column="2" Text="{Binding DateText}" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="{Binding TimeText}" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="{Binding DurationText}" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Grid.Column="5" Text="{Binding SizeText}" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Grid.Column="6" Text="{Binding Operator}" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>

                                <!-- Chip de protección -->
                                <Border Grid.Column="7" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource ButtonBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SignalGreenBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsImportant}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SignalAmberBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ProtectionText}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>

                                <!-- Acciones -->
                                <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{loc:T Rec_Protect}" Style="{StaticResource RowButton}" ToolTip="{loc:T Rec_Tip_Protect}"
                                            Command="{Binding DataContext.ProtectCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{loc:T Rec_Important}" Style="{StaticResource RowButton}" ToolTip="{loc:T Rec_Tip_Important}"
                                            Command="{Binding DataContext.MarkImportantCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{loc:T Rec_Normal}" Style="{StaticResource RowButton}" ToolTip="{loc:T Rec_Tip_Normal}"
                                            Command="{Binding DataContext.UnprotectCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="📂" Style="{StaticResource RowButton}" ToolTip="{loc:T Rec_OpenFolder}"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
