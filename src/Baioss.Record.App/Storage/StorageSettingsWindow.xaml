<Window x:Class="Baioss.Record.App.Storage.StorageSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Almacenamiento" Width="660" Height="720" MinWidth="560"
        WindowStyle="ToolWindow" Background="#10131A" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0C0F15" Padding="16,12">
            <StackPanel>
                <TextBlock Text="ALMACENAMIENTO" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Retención automática, alertas por espacio y modo emergencia. Los cambios se aplican sin reiniciar. Seguro por defecto: nada se borra a menos que actives la retención o la auto-limpieza."
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#0C0F15" Padding="16,10">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource SignalGreenBrush}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Guardar" Command="{Binding SaveCommand}" Style="{StaticResource StartButton}"
                            Height="32" MinWidth="110" Padding="18,0"/>
                    <Button Content="Cerrar" Click="Close_Click" Style="{StaticResource TransportButton}"
                            Height="32" MinWidth="100" Padding="18,0" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
            <StackPanel>
                <!-- RETENCIÓN -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="RETENCIÓN AUTOMÁTICA" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Activar retención automática (borra/archiva grabaciones antiguas)"
                                  IsChecked="{Binding RetentionEnabled}" Style="{StaticResource DarkCheck}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Conservar (días, 0 = no borrar por días)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding RetentionDays}" Style="{StaticResource NumBox}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mantener libre al menos (GB, 0 = off)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding MinFreeGB}" Style="{StaticResource NumBox}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mantener libre al menos (%, 0 = off)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding MinFreePercent}" Style="{StaticResource NumBox}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Revisar cada (minutos, mín. 5)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding IntervalMinutes}" Style="{StaticResource NumBox}"/>
                        </Grid>
                        <CheckBox Content="Archivar en otra carpeta en vez de borrar" IsChecked="{Binding ArchiveInsteadOfDelete}"
                                  Style="{StaticResource DarkCheck}"/>
                        <Grid Margin="0,6,0,0" IsEnabled="{Binding ArchiveInsteadOfDelete}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ArchivePath}" Height="30" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Examinar…" Command="{Binding BrowseArchiveCommand}"
                                    Style="{StaticResource TransportButton}" Height="30" Padding="14,0" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ALERTAS / EMERGENCIA -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="ALERTAS POR ESPACIO Y MODO EMERGENCIA" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Aviso (% ocupado, ámbar)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding WarnPercent}" Style="{StaticResource NumBox}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Crítico (% ocupado)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding CriticalPercent}" Style="{StaticResource NumBox}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Emergencia (% ocupado)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding EmergencyPercent}" Style="{StaticResource NumBox}"/>
                        </Grid>
                        <CheckBox Content="Auto-limpiar al entrar en emergencia (borra lo NO protegido más antiguo)"
                                  IsChecked="{Binding AutoCleanupOnEmergency}" Style="{StaticResource DarkCheck}"/>
                        <CheckBox Content="Bloquear el inicio de nuevas grabaciones durante la emergencia"
                                  IsChecked="{Binding StopNewRecordingsOnEmergency}" Style="{StaticResource DarkCheck}"/>
                        <TextBlock Text="Los umbrales se ordenan solos: aviso ≤ crítico ≤ emergencia. 0 desactiva un umbral."
                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
