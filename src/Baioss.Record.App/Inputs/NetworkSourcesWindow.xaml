<app:SecondaryWindow x:Class="Baioss.Record.App.Inputs.NetworkSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Baioss.Record.App"
        xmlns:loc="clr-namespace:Baioss.Record.App.Localization"
        Title="{loc:T Net_Title}" Height="640" Width="980"
        Icon="/Assets/icon.ico"
        Background="#10131A" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ConfigCombo}"><Setter Property="Margin" Value="0,4"/><Setter Property="Height" Value="26"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}"><Setter Property="Margin" Value="0,4"/><Setter Property="Height" Value="24"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,-2,0,4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Cabecera -->
        <Border DockPanel.Dock="Top" Background="#0C0F15" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{loc:T Net_Header}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{loc:T Net_Intro}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Barra de estado + botones -->
        <Border DockPanel.Dock="Bottom" Background="#0C0F15" Padding="16,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{loc:T Net_New}" Command="{Binding NewSourceCommand}" Style="{StaticResource TransportButton}" MinWidth="90"/>
                    <Button Content="{loc:T Net_Delete}" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}"
                            Style="{StaticResource StopButton}" MinWidth="90" Margin="8,0,0,0"/>
                    <Button Content="{loc:T Net_Save}" Command="{Binding SaveCommand}" Style="{StaticResource StartButton}" MinWidth="110" Margin="8,0,0,0"/>
                    <Button Content="{loc:T Net_Close}" Click="CloseWindow" Style="{StaticResource TransportButton}" MinWidth="90" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de fuentes guardadas -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{loc:T Net_List}" FontSize="9" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Selected}"
                         Background="#12161E" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,3">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Description}" FontSize="10"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Formulario -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Pegar una URL de otro programa -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Net_PasteUrl}"/>
                    <DockPanel Grid.Row="0" Grid.Column="1">
                        <Button DockPanel.Dock="Right" Content="{loc:T Net_Fill}" Command="{Binding FillFromUrlCommand}"
                                Style="{StaticResource TransportButton}" Height="24" Padding="10,0" Margin="6,0,0,0"/>
                        <TextBox Text="{Binding PasteUrl, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Text="{loc:T Net_PasteHint}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Net_Name}"/>
                    <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:T Net_Protocol}"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:T Net_Role}"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:T Net_Host}"/>
                    <TextBox  Grid.Row="5" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Hint}" Text="{Binding HostHint}"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:T Net_Port}"/>
                    <TextBox  Grid.Row="7" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- RTMP: aplicación/clave -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:T Net_Path}"
                               Visibility="{Binding IsRtmp, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Grid.Row="8" Grid.Column="1" Visibility="{Binding IsRtmp, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T Net_PathHint}"/>
                    </StackPanel>
                    <CheckBox Grid.Row="9" Grid.Column="1" Content="{loc:T Net_Secure}" IsChecked="{Binding Secure}" Margin="0,2,0,6"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Visibility="{Binding ShowSecure, Converter={StaticResource BoolToVis}}"/>

                    <!-- SRT: contraseña, latencia, stream id -->
                    <TextBlock Grid.Row="10" Grid.Column="0" Text="{loc:T Net_Passphrase}"
                               Visibility="{Binding IsSrt, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Grid.Row="10" Grid.Column="1" Visibility="{Binding IsSrt, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding Passphrase, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T Net_PassphraseHint}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="11" Grid.Column="0" Text="{loc:T Net_Latency}"
                               Visibility="{Binding IsSrt, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Grid.Row="11" Grid.Column="1" Visibility="{Binding IsSrt, Converter={StaticResource BoolToVis}}">
                        <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding LatencyMs, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T Net_LatencyHint}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="12" Grid.Column="0" Text="{loc:T Net_StreamId}"
                               Visibility="{Binding ShowStreamId, Converter={StaticResource BoolToVis}}"/>
                    <TextBox  Grid.Row="12" Grid.Column="1" Text="{Binding StreamId, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding ShowStreamId, Converter={StaticResource BoolToVis}}"/>

                    <!-- Ajuste fino de sincronía (cualquier protocolo): el relé ya alinea relojes distintos por llegada -->
                    <TextBlock Grid.Row="13" Grid.Column="0" Text="{loc:T Net_AudioDelay}"/>
                    <StackPanel Grid.Row="13" Grid.Column="1">
                        <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding AudioDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T Net_AudioDelayHint}"/>
                    </StackPanel>

                    <!-- Colchón de preview (cualquier protocolo): absorbe una llegada a ráfagas; no toca la grabación -->
                    <TextBlock Grid.Row="14" Grid.Column="0" Text="{loc:T Net_PreviewBuffer}"/>
                    <StackPanel Grid.Row="14" Grid.Column="1">
                        <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding PreviewBufferMs, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T Net_PreviewBufferHint}"/>
                    </StackPanel>

                    <!-- Resultado: cómo se abrirá y qué poner en el emisor -->
                    <Border Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                            Background="#12161E" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding EncoderHint}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</app:SecondaryWindow>
