<Window x:Class="Baioss.Record.App.Inputs.InputsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Baioss.Record.App.Localization"
        Title="{loc:T In_Title}" Height="720" Width="1280"
        Icon="/Assets/icon.ico"
        Background="#10131A" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- Cabecera + Detectar -->
        <Border DockPanel.Dock="Top" Background="#0C0F15" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:T In_Detect}" VerticalAlignment="Center"
                        Command="{Binding DetectCommand}" IsEnabled="{Binding CanRebind}" Style="{StaticResource TransportButton}"/>
                <StackPanel>
                    <TextBlock Text="{loc:T In_Header}" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{loc:T In_Subtitle}"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Barra de estado -->
        <Border DockPanel.Dock="Bottom" Background="#0C0F15" Padding="16,8">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <ItemsControl ItemsSource="{Binding Channels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="6"
                                            Width="40" Height="40" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Key}" FontSize="20" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T In_VideoInput}" FontSize="9"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ComboBox Height="28" ItemsSource="{Binding Devices}"
                                                  SelectedItem="{Binding SelectedDevice}"/>
                                        <!-- Entrada ACTUAL del canal (para saber qué está activo antes de cambiarla). -->
                                        <TextBlock Text="{Binding CurrentInput, StringFormat=Activa: {0}}" FontSize="10" Margin="0,4,0,0"
                                                   Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T In_Audio}" FontSize="9"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ComboBox Height="28" ItemsSource="{Binding AudioDevices}"
                                                  SelectedItem="{Binding SelectedAudio}" IsEnabled="{Binding AudioEnabled}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T In_Format}" FontSize="9"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <!-- Sin DisplayMemberPath: DeviceFormat.ToString() da la etiqueta legible
                                             tanto en la lista como en la caja seleccionada (el estilo del combo
                                             no aplicaba el SelectionBoxItemTemplate y salía el record crudo). -->
                                        <ComboBox Height="28" ItemsSource="{Binding Formats}"
                                                  SelectedItem="{Binding SelectedFormat}" IsEnabled="{Binding FormatEnabled}"/>
                                    </StackPanel>

                                    <!-- Padding propio (no el 14,9 heredado): con Height=28 ese padding recortaba el texto. -->
                                    <Button Grid.Column="4" Content="{loc:T Common_Apply}" Command="{Binding ApplyCommand}"
                                            IsEnabled="{Binding DataContext.CanApply, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource StartButton}" VerticalAlignment="Bottom"
                                            Height="28" MinWidth="92" Padding="18,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,6,0,0"
                           Text="{loc:T In_Footer}"/>

                <!-- ATRIBUCIÓN NDI — OBLIGATORIA por la licencia del SDK de NDI, que exige (a) el enlace a
                     ndi.video «en un lugar cercano a donde NDI se usa o se selecciona dentro del producto»
                     —esta ventana es donde se elige NDI como entrada— y (b) la mención de marca registrada.
                     No quitar sin leer docs\TERCEROS.md. -->
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="2,10,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{loc:T In_NdiTrademark}"/>
                    <Hyperlink NavigateUri="https://ndi.video/" RequestNavigate="OpenLink_RequestNavigate">
                        <Run Text="https://ndi.video/"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
